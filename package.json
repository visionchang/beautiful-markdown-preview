{
  "name": "beautiful-markdown-preview",
  "displayName": "Beautiful Markdown Preview",
  "description": "A beautiful markdown preview extension with multiple switchable themes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/visionchang/beautiful-markdown-preview.git"
  },
  "license": "MIT",
  "version": "0.0.6",
  "publisher": "Vissioon",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:beautifulMarkdownPreview.openPreview",
    "onCustomEditor:beautifulMarkdownPreview.editor"
  ],
  "icon": "assets/icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "beautifulMarkdownPreview.openPreview",
        "title": "Open Beautiful Preview",
        "category": "Beautiful Markdown Preview",
        "icon": {
          "light": "assets/preview-light.svg",
          "dark": "assets/preview-dark.svg"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "beautifulMarkdownPreview.editor",
        "displayName": "Beautiful Preview",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "beautifulMarkdownPreview.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "beautifulMarkdownPreview.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation@100"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.14.0"
  }
}
